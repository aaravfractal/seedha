// Copy to include/secrets.h (gitignored) and fill in. Never commit secrets.h.
#pragma once

#define SEEDHA_WIFI_SSID "your-wifi-name"
#define SEEDHA_WIFI_PASSWORD "your-wifi-password"
// HTTPS base URL of the Seedha API, no trailing slash.
#define SEEDHA_API_BASE "https://api.example.com"
// The DESK_DEVICE_KEY registered for this box (only its hash is stored by the API).
#define SEEDHA_DEVICE_KEY "replace-with-your-desk-key"
// PEM root CA of the API's TLS certificate, so the box verifies the server.
#define SEEDHA_ROOT_CA \
  "-----BEGIN CERTIFICATE-----\n" \
  "...\n" \
  "-----END CERTIFICATE-----\n"
