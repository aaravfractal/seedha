# Seedha environment. Copy to .env (make demo does this for you if .env is missing).
# Every external service is optional: leave a key empty and Seedha runs that
# part in clearly labelled SIMULATED mode. Never commit .env (rule 10).

# --- Core -------------------------------------------------------------------
# SQLite file used by the API (relative paths resolve from apps/api).
DATABASE_URL=sqlite:///./seedha.db
# Shared secret between the web server and the API for owner routes.
# Demo value only: change it for any real deployment.
OWNER_API_TOKEN=demo-owner-token-change-me
# Signs the owner session cookie. Demo value only.
SESSION_SECRET=demo-session-secret-change-me-32chars
# Key the Desk device (or the Desk simulator) sends as X-Device-Key. Demo only.
DESK_DEVICE_KEY=demo-desk-key-change-me
# Where the web app runs (CORS) and where the API runs (web server side).
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:8000
# Web (hosted): the API's base URL, e.g. https://<api>.up.railway.app. Empty =
# API_URL.
API_BASE_URL=
# The address guests and the Desk use to open Seedha (QR codes, Seedha Link).
# Empty = WEB_ORIGIN. make demo-lan and make demo-live set it for you
# (http://<wifi-ip>:3000 or the trycloudflare URL); leave it empty here.
PUBLIC_BASE_URL=
# 1 = public link mode (make demo-live sets it): Reset demo data works only
# from the laptop running Seedha. Leave empty here.
SEEDHA_PUBLIC=
# Web (hosted): 1 on the hosted demo: shows Reset demo data to a signed-in
# owner; the API decides whether the reset is allowed. Empty locally.
SEEDHA_HOSTED=
# The in-house date for the sample hotel. Empty = the day you run make seed.
# Must be after 30 Sep 2026.
DEMO_DATE=
# Owner sign in sends a WhatsApp code through a SIMULATED sender. 1 = local
# demo: the sign-in screen shows the code in a labelled demo banner (and the
# API logs it). Leave empty anywhere real: the code is then never shown or
# logged, so only Direct beta login (sample hotel) works until a real sender
# is connected.
SEEDHA_DEMO=1
# Owner WhatsApp numbers (10 digits, comma-separated) that may run a hotel whose
# data is real. The sample hotel is open to any signed-in session because all of
# its data is fictional; a real hotel refuses everyone not listed here.
OWNER_PHONES=

# --- Hosted deployment (Railway API; leave all empty for local demos) --------
# production = hosted demo safety: refuses to start unless SESSION_SECRET,
# OWNER_API_TOKEN and DESK_DEVICE_KEY are set, are not the demo values above
# and have 32+ characters (openssl rand -hex 32), WEB_ORIGIN / PUBLIC_BASE_URL
# are https origins (comma list allowed, never *), and DATABASE_URL is
# Postgres. Every client counts as remote; the OTP demo banner is off.
SEEDHA_ENV=
# Production only: 1 = allow OTP sign in and sign up for real owner accounts.
# Empty = sample hotel only, through Direct beta login.
ALLOW_OWNER_ACCOUNTS=
# Production only: 1 = demo and public visitors may use Claude (spends your
# credits). Empty = only a real owner account (OWNER_PHONES) uses Claude.
ALLOW_CLAUDE_FOR_DEMO=
# Production only: 1 = demo visitors' proof writes go to Polygon Amoy (spends
# testnet POL). Empty = their roots are stored locally (reason public_mode).
ALLOW_DEMO_PROOF_WRITES=

# --- Public contact addresses (website) ---------------------------------------
# Shown on /contact, /privacy (Grievance Officer), /security and the other
# legal pages. Use role addresses only, never a person's own email. The pages
# are prerendered, so set these before building the web app. Empty = the
# pages say "Contact details will be published before launch."
PUBLIC_CONTACT_EMAIL=
PUBLIC_PRIVACY_EMAIL=
PUBLIC_SECURITY_EMAIL=

# --- Claude (statement reading, match tie-breaks, wording only) -------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- WhatsApp Cloud API (test number) ---------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Signs inbound webhooks (X-Hub-Signature-256). Without it, webhooks are refused.
WHATSAPP_APP_SECRET=
# Graph API version for sends; confirm the current one in Meta's dashboard.
WHATSAPP_API_VERSION=v21.0

# --- Payments: Razorpay test mode (empty = simulated UPI) --------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Proof: Polygon Amoy testnet (empty = Merkle root stored locally only) ---
# Testnet only: the API refuses to send unless PROOF_CHAIN_ID is 80002 and
# the RPC reports chain 80002. Create a fresh key with `make proof-wallet`
# (writes it to .env and prints only the address). Never use a mainnet key.
PROOF_RPC_URL=
PROOF_PRIVATE_KEY=
PROOF_CHAIN_ID=
