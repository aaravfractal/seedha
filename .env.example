# Seedha environment. Copy to .env (make demo does this for you if .env is missing).
# Every external service is optional: leave a key empty and Seedha runs that
# part in clearly labelled SIMULATED mode. Never commit .env (rule 10).

# --- Core -------------------------------------------------------------------
# SQLite file used by the API (relative paths resolve from apps/api).
DATABASE_URL=sqlite:///./seedha.db
# Shared secret between the web server and the API for owner routes.
# Demo value only: change it for any real deployment.
OWNER_API_TOKEN=demo-owner-token-change-me
# Passcode the owner types on the web login screen. Demo value only.
OWNER_PASSCODE=deodar-demo
# Signs the owner session cookie. Demo value only.
SESSION_SECRET=demo-session-secret-change-me-32chars
# Key the Desk device (or the Desk simulator) sends as X-Device-Key. Demo only.
DESK_DEVICE_KEY=demo-desk-key-change-me
# Where the web app runs (CORS) and where the API runs (web server side).
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:8000
# The in-house date for the sample hotel. Empty = the day you run make seed.
# Must be after 30 Sep 2026.
DEMO_DATE=

# --- Claude (statement reading, match tie-breaks, wording only) -------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- WhatsApp Cloud API (test number) ---------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Payments: Razorpay test mode (empty = simulated UPI) --------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Proof: Polygon Amoy testnet (empty = Merkle root stored locally only) ---
PROOF_RPC_URL=
PROOF_PRIVATE_KEY=
